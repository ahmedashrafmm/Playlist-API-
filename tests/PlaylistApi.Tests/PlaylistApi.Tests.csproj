<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Classic xUnit v2 + VSTest, not the newer v3 Testing Platform mode -
         simpler setup, works the same way `dotnet test` has worked for
         years, and is what almost every tutorial/interviewer expects. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- In-memory EF Core provider, used only for the repository test -
         lets us test EF Core query/relationship behavior without a real
         SQLite file. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <!-- Spins up an in-memory test server hosting the real app, for
         true end-to-end integration tests through actual HTTP calls. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlaylistApi.Application\PlaylistApi.Application.csproj" />
    <ProjectReference Include="..\..\src\PlaylistApi.Infrastructure\PlaylistApi.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\PlaylistApi.Api\PlaylistApi.Api.csproj" />
  </ItemGroup>


</Project>
